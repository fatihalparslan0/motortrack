generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Subscription Plans ───────────────────────────────────────────────────────
model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String // Starter, Pro, Enterprise
  priceMonthly  Decimal        @db.Decimal(10, 2)
  priceYearly   Decimal        @db.Decimal(10, 2)
  maxMotors     Int? // null = unlimited
  maxUsers      Int?
  maxListings   Int?
  stripePriceId String?        @unique
  features      Json           @default("{}")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]

  @@map("subscription_plans")
}

// ─── Companies ────────────────────────────────────────────────────────────────
model Company {
  id        String   @id @default(uuid())
  name      String
  taxNumber String?  @unique
  email     String   @unique
  phone     String?
  address   String?
  city      String?
  country   String   @default("TR")
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  motors           Motor[]
  parts            Part[]
  listings         Listing[]
  sentMessages     ListingMessage[] @relation("SentMessages")
  receivedMessages ListingMessage[] @relation("ReceivedMessages")
  subscription     Subscription?

  @@map("companies")
}

// ─── Users ────────────────────────────────────────────────────────────────────
model User {
  id           String    @id @default(uuid())
  companyId    String
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(TECHNICIAN)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshTokens      RefreshToken[]
  maintenanceRecords MaintenanceRecord[]
  partMovements      PartMovement[]
  listings           Listing[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  TECHNICIAN
}

// ─── Auth ─────────────────────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Motors ───────────────────────────────────────────────────────────────────
model Motor {
  id              String      @id @default(uuid())
  companyId       String
  serialNumber    String
  brand           String
  model           String
  motorType       MotorType   @default(AUTOMOTIVE)
  manufactureYear Int?
  purchaseDate    DateTime?
  status          MotorStatus @default(ACTIVE)
  location        String?
  notes           String?
  qrCode          String?     @unique
  imageUrl        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parts              Part[]
  maintenanceRecords MaintenanceRecord[]
  partMovements      PartMovement[]

  @@unique([companyId, serialNumber])
  @@map("motors")
}

enum MotorType {
  AUTOMOTIVE
  INDUSTRIAL
  MOTORCYCLE
  MARINE
  AGRICULTURAL
  OTHER
}

enum MotorStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
  SOLD
}

// ─── Parts ────────────────────────────────────────────────────────────────────
model Part {
  id                String        @id @default(uuid())
  companyId         String
  motorId           String? // Bir motora bağlı olabilir
  partNumber        String?
  name              String
  brand             String?
  category          String?
  quantity          Int           @default(0)
  unit              String        @default("adet")
  minQuantity       Int           @default(0) // Düşük stok uyarı eşiği
  purchasePrice     Decimal?      @db.Decimal(10, 2)
  sellingPrice      Decimal?      @db.Decimal(10, 2)
  warehouseLocation String?
  condition         PartCondition @default(NEW)
  notes             String?
  imageUrls         String[]      @default([])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  motor     Motor?         @relation(fields: [motorId], references: [id], onDelete: SetNull)
  movements PartMovement[]
  listings  Listing[]

  @@map("parts")
}

enum PartCondition {
  NEW
  USED
  REFURBISHED
  DAMAGED
}

// ─── Part Movements (Stok Hareketleri) ───────────────────────────────────────
model PartMovement {
  id           String       @id @default(uuid())
  partId       String
  motorId      String?
  userId       String
  movementType MovementType
  quantity     Int
  notes        String?
  createdAt    DateTime     @default(now())

  part  Part   @relation(fields: [partId], references: [id], onDelete: Cascade)
  motor Motor? @relation(fields: [motorId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id])

  @@map("part_movements")
}

enum MovementType {
  IN // Stok girişi
  OUT // Stok çıkışı / kullanım
  TRANSFER // Transfer
  ADJUSTMENT // Düzeltme
  RETURN // İade
}

// ─── Maintenance Records ──────────────────────────────────────────────────────
model MaintenanceRecord {
  id                  String            @id @default(uuid())
  motorId             String?
  userId              String
  maintenanceType     MaintenanceType
  title               String
  description         String?
  cost                Decimal?          @db.Decimal(10, 2)
  customerInfo        String?
  vehicleInfo         String?
  performedAt         DateTime          @default(now())
  nextMaintenanceDate DateTime?
  status              MaintenanceStatus @default(COMPLETED)
  imageUrls           String[]          @default([])
  createdAt           DateTime          @default(now())

  motor Motor? @relation(fields: [motorId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id])

  @@map("maintenance_records")
}

enum MaintenanceType {
  PREVENTIVE // Önleyici bakım
  CORRECTIVE // Düzeltici bakım
  INSPECTION // Muayene
  EMERGENCY // Acil bakım
  OTHER
}

enum MaintenanceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Listings (B2B Pazar Yeri) ────────────────────────────────────────────────
model Listing {
  id          String        @id @default(uuid())
  companyId   String
  userId      String
  partId      String?
  title       String
  description String
  price       Decimal       @db.Decimal(10, 2)
  currency    String        @default("TRY")
  quantity    Int           @default(1)
  condition   PartCondition @default(USED)
  imageUrls   String[]      @default([])
  status      ListingStatus @default(ACTIVE)
  viewsCount  Int           @default(0)
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id])
  part     Part?            @relation(fields: [partId], references: [id], onDelete: SetNull)
  messages ListingMessage[]

  @@map("listings")
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  EXPIRED
  DELETED
}

// ─── Listing Messages ─────────────────────────────────────────────────────────
model ListingMessage {
  id                String   @id @default(uuid())
  listingId         String
  senderCompanyId   String
  receiverCompanyId String
  message           String
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())

  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  senderCompany   Company @relation("SentMessages", fields: [senderCompanyId], references: [id])
  receiverCompany Company @relation("ReceivedMessages", fields: [receiverCompanyId], references: [id])

  @@map("listing_messages")
}

// ─── Subscriptions ────────────────────────────────────────────────────────────
model Subscription {
  id                   String             @id @default(uuid())
  companyId            String             @unique
  planId               String
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  status               SubscriptionStatus @default(TRIAL)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}
