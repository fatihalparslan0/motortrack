generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Subscription Plans ───────────────────────────────────────────────────────
model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String // Starter, Pro, Enterprise
  priceMonthly  Decimal        @db.Decimal(10, 2)
  priceYearly   Decimal        @db.Decimal(10, 2)
  maxMotors     Int? // null = unlimited
  maxUsers      Int?
  stripePriceId String?        @unique
  features      Json           @default("{}")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]

  @@map("subscription_plans")
}

// ─── Companies ────────────────────────────────────────────────────────────────
model Company {
  id        String   @id @default(uuid())
  name      String
  taxNumber String?  @unique
  email     String   @unique
  phone     String?
  address   String?
  city      String?
  country   String   @default("TR")
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  motors           Motor[]
  parts            Part[]
  subscription     Subscription?
  warehouses       Warehouse[]
  suppliers        Supplier[]
  workOrders       WorkOrder[]
  purchaseRecords  PurchaseRecord[]
  supplierTransactions SupplierTransaction[]
  cashTransactions     CashTransaction[]
  dailyRegisterCloses  DailyRegisterClose[]

  @@map("companies")
}

// ─── Users ────────────────────────────────────────────────────────────────────
model User {
  id           String    @id @default(uuid())
  companyId    String
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(TECHNICIAN)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshTokens      RefreshToken[]
  maintenanceRecords MaintenanceRecord[]
  partMovements      PartMovement[]
  workOrders           WorkOrder[]
  purchaseRecords      PurchaseRecord[]
  supplierTransactions SupplierTransaction[]
  cashTransactions     CashTransaction[]
  dailyRegisterCloses  DailyRegisterClose[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  TECHNICIAN
}

// ─── Auth ─────────────────────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Motors ───────────────────────────────────────────────────────────────────
model Motor {
  id              String      @id @default(uuid())
  companyId       String
  serialNumber    String
  brand           String
  model           String
  motorType       MotorType   @default(AUTOMOTIVE)
  manufactureYear Int?
  purchaseDate    DateTime?
  status          MotorStatus @default(ACTIVE)
  location        String?
  notes           String?
  qrCode          String?     @unique
  imageUrl        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parts              Part[]
  maintenanceRecords MaintenanceRecord[]
  partMovements      PartMovement[]

  @@unique([companyId, serialNumber])
  @@map("motors")
}

enum MotorType {
  AUTOMOTIVE
  INDUSTRIAL
  MOTORCYCLE
  MARINE
  AGRICULTURAL
  OTHER
}

enum MotorStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
  SOLD
}

// ─── Parts ────────────────────────────────────────────────────────────────────
model Part {
  id                String        @id @default(uuid())
  companyId         String
  motorId           String?
  partNumber        String?
  sku               String?       // Stok kodu
  barcode           String?       // Barkod
  oemCode           String?       // OEM / Parça kodu
  name              String
  brand             String?
  category          String?
  quantity          Int           @default(0)
  reservedQuantity  Int           @default(0) // Rezerve edilmiş miktar
  unit              String        @default("adet")
  minQuantity       Int           @default(0) // Kritik stok eşiği
  maxQuantity       Int?          // Maksimum stok seviyesi
  purchasePrice     Decimal?      @db.Decimal(10, 2)
  sellingPrice      Decimal?      @db.Decimal(10, 2)
  warehouseLocation String?
  condition         PartCondition @default(NEW)
  isActive          Boolean       @default(true)
  notes             String?
  imageUrls         String[]      @default([])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  motor           Motor?           @relation(fields: [motorId], references: [id], onDelete: SetNull)
  movements       PartMovement[]
  warehouseStocks WarehouseStock[]
  workOrderItems  WorkOrderItem[]
  purchaseRecords PurchaseRecord[]

  @@map("parts")
}

enum PartCondition {
  NEW
  USED
  REFURBISHED
  DAMAGED
}

// ─── Part Movements (Stok Hareketleri) ───────────────────────────────────────
model PartMovement {
  id            String            @id @default(uuid())
  partId        String
  warehouseId   String?
  motorId       String?
  userId        String
  movementType  StockMovementType
  quantity      Int               // Hareket miktarı (her zaman pozitif; tip giriş/çıkış belirler)
  unitCost      Decimal?          @db.Decimal(10, 2)
  referenceType String?           // "WORK_ORDER", "PURCHASE", "SALE", "SUPPLIER_RETURN", "WORKSHOP_CONSUMPTION"
  referenceId   String?
  documentNo    String?           // İrsaliye, fatura veya fiş no
  notes         String?
  createdAt     DateTime          @default(now())

  part      Part       @relation(fields: [partId], references: [id], onDelete: Cascade)
  motor     Motor?     @relation(fields: [motorId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@map("part_movements")
}

enum StockMovementType {
  SATIN_ALMA        // Satın alma
  IS_EMRI_KULLANIMI // İş emrinde kullanım
  SATIS             // Satış
  IADE              // İade
  FIRE              // Fire / zayi
  DUZELTME          // Manuel düzeltme
  DEPO_TRANSFERI    // Depolar arası transfer
  ATOLYE_SARFI      // Atölye sarfiyatı (balata spreyi, sıvı conta vb.)
  // Geriye dönük uyumluluk
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

// ─── Warehouses (Depolar) ─────────────────────────────────────────────────────
model Warehouse {
  id          String        @id @default(uuid())
  companyId   String
  name        String
  type        WarehouseType @default(MAIN)
  address     String?
  description String?
  isActive    Boolean       @default(true)
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks        WarehouseStock[]
  partMovements PartMovement[]

  @@map("warehouses")
}

enum WarehouseType {
  MAIN                 // Ana Yedek Parça Deposu (Kilitli / Sıfır Parçalar)
  WORKSHOP_CONSUMABLES // Atölye Hızlı Sarfiyat & Yağ Reyonu (Sprey, Conta, Yağ)
  USED_PARTS           // Çıkma & Revizyon Deposu (İkinci El / Yenilenmiş Parçalar)
  SCRAP                // Eski / Değişen Parça & Hurda Alanı (Müşteri İade / Hurda)
  OTHER                // Diğer / Harici Depo
}

// ─── Warehouse Stocks (Depo Bazında Stok) ─────────────────────────────────────
model WarehouseStock {
  id            String   @id @default(uuid())
  warehouseId   String
  partId        String
  quantity      Int      @default(0)
  shelfLocation String?  // Raf / Göz / Kutu Kodu (Örn: A-3 Kat-2 Kutu-14)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  part      Part      @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, partId])
  @@map("warehouse_stocks")
}

// ─── Suppliers (Tedarikçiler / Parçacılar) ────────────────────────────────────
model Supplier {
  id            String   @id @default(uuid())
  companyId     String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  balance       Decimal  @default(0) @db.Decimal(10, 2) // Parçacıya olan borç bakiyesi (TL)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseRecords PurchaseRecord[]
  transactions    SupplierTransaction[]

  @@map("suppliers")
}

// ─── Supplier Transactions (Tedarikçi Cari / Borç Hareketleri) ────────────────
model SupplierTransaction {
  id            String                  @id @default(uuid())
  companyId     String
  supplierId    String
  userId        String
  type          SupplierTransactionType // ALIS, ODEME, IADE
  amount        Decimal                 @db.Decimal(10, 2)
  paymentMethod String?                 // NAKIT, HAVALE, KREDI_KARTI, CEK
  documentNo    String?                 // Fiş / İrsaliye / Makbuz No
  notes         String?
  createdAt     DateTime                @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@map("supplier_transactions")
}

enum SupplierTransactionType {
  ALIS      // Parça alışı (Borç artar)
  ODEME     // Tedarikçiye yapılan ödeme (Borç azalır)
  IADE      // Parça iadesi (Borç azalır)
}

// ─── Purchase Records (Satın Alma Kayıtları) ──────────────────────────────────
model PurchaseRecord {
  id            String   @id @default(uuid())
  companyId     String
  partId        String
  supplierId    String?
  userId        String
  quantity      Int
  unitCost      Decimal  @db.Decimal(10, 2)
  totalCost     Decimal  @db.Decimal(10, 2)
  invoiceNumber String?  // İrsaliye veya Fatura / Fiş No
  notes         String?
  purchasedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  part     Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id])

  @@map("purchase_records")
}

// ─── Work Orders (İş Emirleri) ────────────────────────────────────────────────
model WorkOrder {
  id            String          @id @default(uuid())
  companyId     String
  userId        String          // Sorumlu / zimmetli kullanıcı
  creatorId     String?         // İş emrini oluşturan asıl kullanıcı
  previousUserId String?        // Başlatılmadan önceki asıl sahip (geri alınınca iade etmek için)
  title         String
  description   String?
  customerName  String?
  customerPhone String?
  vehicleInfo   String?
  status        WorkOrderStatus @default(ACIK)
  laborCost     Decimal?        @db.Decimal(10, 2)
  notes         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Yönetici Onayı & Personel Devralma / Zimmet Yönetimi
  isApproved            Boolean   @default(true)
  approvedById          String?
  approvedAt            DateTime?
  takeoverRequestedById String?
  takeoverRequestedAt   DateTime?

  // Ödeme ve Veresiye Takibi
  paymentStatus PaymentStatus   @default(BEKLIYOR)
  paidAmount    Decimal?        @default(0) @db.Decimal(10, 2)
  paymentMethod String?         // NAKIT, KREDI_KARTI, HAVALE, VERESIYE
  paymentNotes  String?

  // Öncesi / Sonrası Parça & Ekspertiz Fotoğrafları
  beforeImages  String[]        @default([])
  afterImages   String[]        @default([])

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])
  items   WorkOrderItem[]

  @@map("work_orders")
}

enum WorkOrderStatus {
  ACIK
  DEVAM_EDIYOR
  TAMAMLANDI
  IPTAL
}

enum PaymentStatus {
  BEKLIYOR
  ODENDI
  KISMI
  VERESIYE
}

// ─── Work Order Items (İş Emri Parçaları) ────────────────────────────────────
model WorkOrderItem {
  id          String              @id @default(uuid())
  workOrderId String
  partId      String
  warehouseId String?             // Kullanıldığı depo
  quantity    Int
  unitPrice   Decimal             @db.Decimal(10, 2)
  unitCost    Decimal?            @db.Decimal(10, 2)
  status      WorkOrderItemStatus @default(BEKLIYOR)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part      @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@map("work_order_items")
}

enum WorkOrderItemStatus {
  BEKLIYOR
  REZERVE
  KULLANILDI
  IPTAL
}

// ─── Maintenance Records ──────────────────────────────────────────────────────
model MaintenanceRecord {
  id                  String            @id @default(uuid())
  motorId             String?
  userId              String
  maintenanceType     MaintenanceType
  title               String
  description         String?
  cost                Decimal?          @db.Decimal(10, 2)
  customerInfo        String?
  vehicleInfo         String?
  performedAt         DateTime          @default(now())
  nextMaintenanceDate DateTime?
  status              MaintenanceStatus @default(COMPLETED)
  imageUrls           String[]          @default([])
  createdAt           DateTime          @default(now())

  motor Motor? @relation(fields: [motorId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id])

  @@map("maintenance_records")
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  EMERGENCY
  OTHER
}

enum MaintenanceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Subscriptions ────────────────────────────────────────────────────────────
model Subscription {
  id                   String             @id @default(uuid())
  companyId            String             @unique
  planId               String
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  status               SubscriptionStatus @default(TRIAL)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// ─── Kasa & Günlük Hareketler ────────────────────────────────────────────────
model CashTransaction {
  id            String              @id @default(uuid())
  companyId     String
  userId        String
  type          CashTransactionType
  category      String              // TAHSILAT, DEVIR_GIRIS, PERSONEL, YEMEK, MALZEME, FATURA_KIRA, DIGER_CIKIS, ORTAK_EKLEME, vb.
  amount        Decimal             @db.Decimal(10, 2)
  paymentMethod String              @default("NAKIT") // NAKIT, KREDI_KARTI, HAVALE
  documentNo    String?             // Fiş / Makbuz / Fatura no
  description   String?
  date          DateTime            @default(now())
  createdAt     DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("cash_transactions")
}

enum CashTransactionType {
  IN   // Kasa Girişi
  OUT  // Kasa Çıkışı
}

// ─── Gün Sonu Kasa Kapatma (Z-Raporu) ─────────────────────────────────────────
model DailyRegisterClose {
  id                   String   @id @default(uuid())
  companyId            String
  userId               String
  date                 DateTime // Rapor tarihi
  openingCash          Decimal  @default(0) @db.Decimal(10, 2)
  cashIncome           Decimal  @default(0) @db.Decimal(10, 2)
  posIncome            Decimal  @default(0) @db.Decimal(10, 2)
  transferIncome       Decimal  @default(0) @db.Decimal(10, 2)
  cashExpense          Decimal  @default(0) @db.Decimal(10, 2)
  expectedCash         Decimal  @default(0) @db.Decimal(10, 2)
  actualCash           Decimal  @default(0) @db.Decimal(10, 2)
  discrepancy          Decimal  @default(0) @db.Decimal(10, 2)
  transferredToNextDay Decimal  @default(0) @db.Decimal(10, 2)
  takenByOwner         Decimal  @default(0) @db.Decimal(10, 2)
  totalRevenue         Decimal  @default(0) @db.Decimal(10, 2)
  workOrdersCompleted  Int      @default(0)
  notes                String?
  status               String   @default("CLOSED")
  createdAt            DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([companyId, date])
  @@map("daily_register_closes")
}

